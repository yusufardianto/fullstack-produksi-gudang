# Port aplikasi server Node.js
PORT=3000

# Konfigurasi Lingkungan (development / production / test)
NODE_ENV=development

# Konfigurasi Koneksi Database MySQL (Laragon / Lokal)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Kosongkan jika MySQL Laragon Anda tidak menggunakan password (default)
# Atau isi jika Anda telah mengatur password untuk user root
DB_PASSWORD=
DB_NAME=db_produksi_gudang
